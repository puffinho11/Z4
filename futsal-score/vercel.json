{
  "version": 2,
  "builds": [
    {
      "src": "vite.config.js",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://z4-production.up.railway.app/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://z4esporte.com/$1",
      "permanent": true
    }
  ]
}

